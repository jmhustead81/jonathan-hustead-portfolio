---
import { site } from '../data/site';
---

<section class="hero" id="top" aria-labelledby="hero-name">
  <div class="container hero__grid">
    <div class="hero__content">
      <p class="hero__role">{site.title}</p>
      <h1 id="hero-name">{site.name}</h1>
      <p class="hero__tagline">{site.tagline}</p>
      <div class="button-row hero__actions">
        <a class="button button--primary" href="#work">View selected work</a>
        <a class="button button--ghost" href={site.links.resume} download>Download resume</a>
      </div>
      <p class="hero__meta">{site.location}</p>
    </div>

    <figure class="hero__portrait">
      <img
        src={site.headshot.src}
        srcset={site.headshot.srcSet}
        sizes={site.headshot.sizes}
        alt={site.headshot.alt}
        width={site.headshot.width}
        height={site.headshot.height}
        fetchpriority="high"
        decoding="async"
      />
    </figure>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: calc(100svh - var(--nav-h));
    display: grid;
    align-items: center;
    padding-block: clamp(2.5rem, 7vh, 5rem);
    overflow: clip;
  }

  .hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(12rem, 16rem);
    gap: clamp(2rem, 5vw, 3.5rem);
    align-items: center;
  }

  .hero__content {
    animation: heroRise 800ms var(--ease) both;
  }

  .hero__role {
    margin-bottom: 0.9rem;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
  }

  h1 {
    font-size: clamp(2.5rem, 5.5vw, 4rem);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.05;
    max-width: 12ch;
  }

  .hero__tagline {
    margin-top: 1.25rem;
    max-width: 34rem;
    font-size: clamp(1.02rem, 1.6vw, 1.15rem);
    line-height: 1.55;
    color: var(--ink-soft);
  }

  .hero__actions {
    margin-top: 1.75rem;
  }

  .hero__meta {
    margin-top: 1.4rem;
    font-size: 0.92rem;
    color: var(--muted);
  }

  .hero__portrait {
    margin: 0;
    justify-self: end;
    width: min(100%, 16rem);
    animation: heroRise 800ms var(--ease) 120ms both;
  }

  .hero__portrait img {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: center top;
    border-radius: var(--radius);
    border: 1px solid var(--line);
    background: var(--surface);
  }

  @keyframes heroRise {
    from {
      opacity: 0;
      transform: translateY(1rem);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (max-width: 820px) {
    .hero {
      min-height: auto;
      align-items: start;
    }

    .hero__grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .hero__portrait {
      justify-self: start;
      width: min(100%, 18rem);
      order: -1;
    }

    h1 {
      max-width: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__content,
    .hero__portrait {
      animation: none;
    }
  }
</style>
