---
import { site } from '../data/site';
---

<section class="hero" id="top" aria-labelledby="hero-name">
  <div class="hero__media" aria-hidden="false">
    <img
      src={site.headshot.src}
      alt={site.headshot.alt}
      width="960"
      height="960"
      fetchpriority="high"
      decoding="async"
    />
  </div>
  <div class="hero__content container">
    <p class="hero__role">{site.title}</p>
    <h1 id="hero-name">{site.name}</h1>
    <p class="hero__tagline">{site.tagline}</p>
    <div class="button-row hero__actions">
      <a class="button button--primary" href="#work">View selected work</a>
      <a class="button button--ghost" href={site.links.resume} download>Download resume</a>
    </div>
    <p class="hero__meta">{site.location}</p>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: calc(100svh - var(--nav-h));
    display: grid;
    align-items: end;
    overflow: clip;
    isolation: isolate;
  }

  .hero__media {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  .hero__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
    transform: scale(1.04);
    animation: heroZoom 8s var(--ease) both;
  }

  .hero__media::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgba(10, 22, 40, 0.88) 0%, rgba(10, 22, 40, 0.62) 42%, rgba(10, 22, 40, 0.18) 72%, rgba(10, 22, 40, 0.08) 100%),
      linear-gradient(180deg, rgba(10, 22, 40, 0.18) 0%, rgba(10, 22, 40, 0.72) 100%);
  }

  .hero__content {
    width: min(100% - 2rem, 42rem);
    margin: 0;
    margin-inline: max(1rem, calc((100% - var(--content)) / 2));
    padding-block: clamp(4rem, 12vh, 7rem) clamp(3rem, 8vh, 5rem);
    color: #f4f7fb;
    animation: heroRise 900ms var(--ease) both;
  }

  .hero__role {
    margin-bottom: 0.85rem;
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #9fe8e1;
  }

  h1 {
    font-size: clamp(3rem, 8vw, 5.4rem);
    font-weight: 800;
    letter-spacing: -0.04em;
    line-height: 0.95;
    max-width: 9ch;
  }

  .hero__tagline {
    margin-top: 1.35rem;
    max-width: 34rem;
    font-size: clamp(1.05rem, 2vw, 1.2rem);
    line-height: 1.55;
    color: rgba(244, 247, 251, 0.86);
  }

  .hero__actions {
    margin-top: 1.75rem;
  }

  .hero__actions :global(.button--primary) {
    background: #0b7f78;
  }

  .hero__actions :global(.button--primary:hover) {
    background: #065f5a;
  }

  .hero__actions :global(.button--ghost) {
    border-color: rgba(244, 247, 251, 0.35);
    color: #f4f7fb;
  }

  .hero__actions :global(.button--ghost:hover) {
    background: rgba(244, 247, 251, 0.1);
    border-color: #f4f7fb;
    color: #f4f7fb;
  }

  .hero__meta {
    margin-top: 1.5rem;
    font-size: 0.92rem;
    color: rgba(244, 247, 251, 0.68);
  }

  @keyframes heroRise {
    from {
      opacity: 0;
      transform: translateY(1.5rem);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes heroZoom {
    from {
      transform: scale(1.1);
    }
    to {
      transform: scale(1.04);
    }
  }

  @media (max-width: 720px) {
    .hero__media::after {
      background:
        linear-gradient(180deg, rgba(10, 22, 40, 0.35) 0%, rgba(10, 22, 40, 0.82) 55%, rgba(10, 22, 40, 0.92) 100%);
    }

    .hero__content {
      width: min(100% - 2rem, var(--content));
      margin-inline: auto;
    }

    h1 {
      max-width: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__content,
    .hero__media img {
      animation: none;
    }
  }
</style>
